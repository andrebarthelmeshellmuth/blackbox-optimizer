<?xml version="1.0"?>
<ruleset name="BlackboxOptimizer"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Complexity / method- and class-size limits for andrebarthelmeshellmuth/blackbox-optimizer.</description>

    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml">
        <exclude name="CamelCasePropertyName"/>
    </rule>
    <rule ref="rulesets/design.xml">
        <!-- DifferentialEvolutionAlgorithm's pickThreeDistinctOthers() rejection-sampling loop
             legitimately re-checks count() each iteration; caching it upfront would be premature, not
             an improvement, at this loop's trivial size. -->
        <exclude name="CountInLoopExpression"/>
    </rule>
    <rule ref="rulesets/naming.xml">
        <!-- CMA-ES's own math notation (n, mu, cc, c1, z, y, x, sigma-path variables, etc.) matches
             Hansen's own reference implementation and "The CMA Evolution Strategy: A Tutorial", a paper
             this class's own docblock cites, exactly. Renaming these to satisfy a generic minimum-length
             rule would make the code LESS reviewable against the source it was ported from, not more. -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
